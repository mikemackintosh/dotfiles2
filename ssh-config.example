# Template for ~/.ssh/config. Nothing here is secret, but the key file it
# names is personal, so the real config stays out of this repo.
#
#   cp ~/.dotfiles/ssh-config.example ~/.ssh/config   # or merge by hand
#   chmod 600 ~/.ssh/config
#
# Keys live in 1Password, not on disk; its agent serves them.
Host *
  IdentityAgent "~/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
  # Keepalives. A long-lived session behind NAT gets reaped when it goes
  # quiet, and the drop is not graceful: whatever put the terminal into
  # mouse-reporting mode (tmux with `mouse on`) never sends the reset, so
  # the LOCAL terminal keeps encoding pointer movement as keystrokes —
  # `35;90;24M` typed into your prompt. zsh/mouse-guard.zsh clears that
  # afterwards; these two make it happen less. 60s x 3 = a dead link is
  # noticed in three minutes instead of whenever TCP gets around to it.
  ServerAliveInterval 60
  ServerAliveCountMax 3

# Which key ssh offers first is pinned in ~/.config/1Password/ssh/agent.toml,
# written by `git-identity base`: it lists the keys this Mac may offer, in
# order, and 1Password serves nothing else. That is what stops a deploy
# key from shadowing the account key. Without it ssh offers every key the
# agent holds, in the agent's order, and stops at the first one GitHub
# accepts. If that happens to be a repo deploy key — which are read-only
# by default — authentication "succeeds" and every push then fails with:
#
#   ERROR: The key you are authenticating with has been marked as read only
#
# The tell is in `ssh -T git@github.com`: an account key answers
# "Hi <username>!", a deploy key answers "Hi <owner>/<repo>!".
#
# Per-host pinning is still possible when agent order is not enough (two
# GitHub accounts, say). IdentityFile then points at a PUBLIC key: ssh
# uses it to pick the matching private key out of the agent, so nothing
# private touches disk. Off by default — with IdentitiesOnly, a missing
# .pub means ssh offers NOTHING and every push fails.
#
# Host github.com
#   IdentitiesOnly yes
#   IdentityFile ~/.ssh/github-account.pub


# --- Signing a commit on a REMOTE host ---------------------------------
#
# 1Password's agent is bound to the unlocked desktop app, so installing
# 1Password on the remote box does not help: each signature raises an
# approval prompt on THAT machine's screen and nobody is there to click
# it, so the commit just hangs. Forward this Mac's agent instead and the
# prompt lands where you are.
#
# Per-host, never in `Host *` — forwarding lends your whole keyring to
# whoever is root on the far end, for as long as the session is up.
#
#   Host myremote
#     ForwardAgent yes
#
# ForwardAgent is read at connection setup, so an already-open session
# never picks it up — and ControlMaster silently reuses the old,
# unforwarded connection. Drop the master, then check:
#
#   ssh -O exit myremote 2>/dev/null; ssh myremote 'ssh-add -l'
#
# Keys listed = the socket arrived. Nothing = remote sshd has
# AllowAgentForwarding no, and no git config will save you.
#
# Then three things on the remote, each of which fails by blaming
# something else:
#
#   1. gpg.ssh.program must name a file that exists THERE.
#      ~/.private/gitconfig hardcodes /Users/<you>/.dotfiles/bin/... —
#      on Linux that path is absent and signing dies before it reaches
#      the agent. Clone the dotfiles and repoint it (bin/git-ssh-sign
#      already falls through to ssh-keygen when /Applications is not),
#      or unset the key and let git call ssh-keygen directly.
#   2. user.signingkey must be the PUBLIC key text. `ssh-keygen -Y sign`
#      uses it to select the matching private key out of the agent.
#   3. OpenSSH >= 8.9 (`ssh -V`). Earlier ssh-keygen cannot sign with an
#      agent-held key at all, and says so in the vocabulary of a bad key.
#
# Prove it before trusting it — this should prompt on the Mac:
#
#   echo test | ssh-keygen -Y sign -n git -f ~/.ssh/github-account.pub
#
# Copy the `Host github.com` block above to the remote too, or the
# forwarded agent replays the deploy-key roulette described there.
#
# Under tmux, SSH_AUTH_SOCK names the socket from the login that created
# the session. Reattach it from a later ssh and that path is dead —
# "agent refused operation", with a live agent one hop away. Pin it:
#
#   ln -sf "$SSH_AUTH_SOCK" ~/.ssh/agent.sock    # at login
#   export SSH_AUTH_SOCK=~/.ssh/agent.sock       # in the remote's rc
#

# --- Debugging a key that will not authenticate ------------------------
#
# `Permission denied (publickey,...)` never says WHICH problem you have,
# because the client genuinely cannot tell the difference between:
#
#   1. the key is not in the server's ~/.ssh/authorized_keys
#   2. it IS there, and sshd refuses to read it over file permissions
#
# `ssh -vvv` distinguishes agent problems from server problems but not
# these two from each other. Offering a key and getting back
# "Authentications that can continue" means the server rejected it —
# the agent did its job.
#
# Case 1: compare fingerprints. Locally `ssh-add -l`, remotely
#   `ssh-keygen -lf ~/.ssh/authorized_keys`. No match, no auth.
#   Fix: ssh-copy-id -i ~/.ssh/<key>.pub user@host
#
# Case 2: sshd ignores authorized_keys if anything in the path is
#   writable by group or other. It says so only in ITS log
#   (`journalctl -u sshd` / /var/log/auth.log):
#     Authentication refused: bad ownership or modes for directory /home/u
#   Fix, on the remote: chmod go-w ~ && chmod 700 ~/.ssh &&
#                       chmod 600 ~/.ssh/authorized_keys
