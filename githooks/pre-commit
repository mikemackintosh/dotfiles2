#!/usr/bin/env bash
# pre-commit — Go hygiene on staged files.
#
# Runs gofmt -l (format check, no rewrite) and go vet against the
# packages containing the staged .go files. Skips silently if no Go
# files are staged or if the toolchain isn't installed.
#
# Wired in globally via core.hooksPath in ~/.dotfiles/.gitconfig.
# Bypass once:   git commit --no-verify

set -uo pipefail

mapfile -t staged_go < <(git diff --cached --name-only --diff-filter=ACM 2>/dev/null \
                        | grep -E '\.go$' || true)
[[ ${#staged_go[@]} -eq 0 ]] && exit 0

fail=0

# gofmt — format check only; don't auto-write into the index.
if command -v gofmt >/dev/null 2>&1; then
    unformatted=$(gofmt -l "${staged_go[@]}" 2>/dev/null || true)
    if [[ -n $unformatted ]]; then
        echo "pre-commit: gofmt failures in staged files:" >&2
        echo "$unformatted" | sed 's/^/    /' >&2
        echo "  Fix: gofmt -w ${staged_go[*]}" >&2
        fail=1
    fi
fi

# go vet — only run when inside a Go module, and only on packages
# that contain staged files (avoids vetting the whole tree).
if command -v go >/dev/null 2>&1; then
    gomod=$(go env GOMOD 2>/dev/null || true)
    if [[ -n $gomod && $gomod != "/dev/null" && $gomod != "off" ]]; then
        mapfile -t pkgs < <(printf '%s\n' "${staged_go[@]}" \
                            | xargs -n1 dirname \
                            | sort -u \
                            | sed 's|^|./|')
        if ! go vet "${pkgs[@]}" 2>&1; then
            echo "pre-commit: go vet failed" >&2
            fail=1
        fi
    fi
fi

if (( fail )); then
    echo >&2
    echo "Bypass once: git commit --no-verify" >&2
    exit 1
fi
exit 0
