#!/usr/bin/env bash
# image-audit — scan the Docker images this repo uses for fixable HIGH/CRITICAL
# CVEs, and (with --fix) pull fresh base images / rebuild local ones and rescan.
#
# Usage:
#   image-audit            # report only; exit 1 if any fixable CVE remains
#   image-audit --fix      # pull/rebuild images with fixable CVEs, then rescan
#   image-audit --json     # one JSON object per image on stdout (for the agent)
#   image-audit -q         # quiet: no desktop notification (still logs/stdout)
#
# Images come from bin/docker-shim + bin/chrome-devtools-mcp (stock images,
# refreshed with `docker pull`) and docker/*/ (local builds, rebuilt via
# rebuild-images). trivy's vuln DB (GHSA + NVD) refreshes each run, so a
# weekly run surfaces newly-published advisories. The LaunchAgent that
# install.sh writes runs `image-audit --fix` on that cadence.
#
# Only *fixable* HIGH/CRITICAL are counted (--ignore-unfixed): a vuln with no
# released fix is noise you can't act on by rebuilding.

set -euo pipefail

root="$(cd "$(dirname "$(readlink -f "$0")")/.." && pwd)"

fix=0 json=0 quiet=0
for a in "$@"; do
    case "$a" in
        --fix) fix=1 ;;
        --json) json=1 ;;
        -q|--quiet) quiet=1 ;;
        -h|--help) sed -n '2,20p' "$0" | sed 's/^# \{0,1\}//'; exit 0 ;;
        *) echo "image-audit: unknown arg $a" >&2; exit 2 ;;
    esac
done

command -v trivy  >/dev/null 2>&1 || { echo "image-audit: trivy not found — brew install trivy" >&2; exit 127; }
command -v docker >/dev/null 2>&1 || { echo "image-audit: docker not found" >&2; exit 127; }
command -v jq     >/dev/null 2>&1 || { echo "image-audit: jq not found" >&2; exit 127; }

# Stock images the shims run (same discovery as rebuild-images, so the two
# can't drift), and the local images built from docker/*/.
stock() {
    {
        sed -n 's/.*image_default="\([^"]\{1,\}\)".*/\1/p' "$root/bin/docker-shim"
        sed -n 's/^IMAGE="\${[A-Z_]*:-\([^}]*\)}"$/\1/p' "$root/bin/chrome-devtools-mcp"
    } | sort -u
}
locals() {
    local f
    for f in "$root"/docker/*/Dockerfile; do
        [[ -f $f ]] && echo "$(basename "$(dirname "$f")"):local"
    done
}

# Count fixable HIGH/CRITICAL vulns in an image. Missing image → -1 (skip).
scan() {
    docker image inspect "$1" >/dev/null 2>&1 || { echo -1; return; }
    trivy image --quiet --scanners vuln --severity HIGH,CRITICAL \
        --ignore-unfixed --format json "$1" 2>/dev/null \
        | jq '[.Results[]?.Vulnerabilities[]?] | length' 2>/dev/null || echo 0
}

_notify() { # _notify <title> <message>
    (( quiet )) && return 0
    command -v osascript >/dev/null 2>&1 \
        && osascript -e "display notification \"$2\" with title \"$1\"" >/dev/null 2>&1 || true
    printf '\a' 2>/dev/null || true
}

actionable=0 acted=0
report=()

audit_one() { # audit_one <image> <stock|local>
    local img=$1 kind=$2 before after=""
    before=$(scan "$img")
    (( before < 0 )) && return 0           # not present locally; nothing to scan
    if (( before == 0 )); then
        (( json )) && printf '{"image":%s,"kind":%s,"fixable":0}\n' "$(jq -Rn --arg v "$img" '$v')" "$(jq -Rn --arg v "$kind" '$v')"
        report+=("ok    $img — 0 fixable")
        return 0
    fi
    actionable=1
    if (( fix )); then
        if [[ $kind == stock ]]; then
            docker pull -q "$img" >/dev/null 2>&1 || true
        else
            "$root/bin/rebuild-images" "${img%:local}" >/dev/null 2>&1 || true
            acted=1
        fi
        [[ $kind == stock ]] && acted=1
        after=$(scan "$img")
    fi
    (( json )) && printf '{"image":%s,"kind":%s,"fixable":%s,"after":%s}\n' \
        "$(jq -Rn --arg v "$img" '$v')" "$(jq -Rn --arg v "$kind" '$v')" "$before" "${after:-null}"
    if [[ -n $after ]]; then
        report+=("FIX   $img — $before → $after fixable")
    else
        report+=("CVE   $img — $before fixable (run with --fix)")
    fi
}

while IFS= read -r img; do [[ -n $img ]] && audit_one "$img" stock; done < <(stock)
while IFS= read -r img; do [[ -n $img ]] && audit_one "$img" local; done < <(locals)

if (( ! json )); then
    printf '%s\n' "${report[@]}"
fi

# A remaining fixable CVE after a --fix run (or any in report-only) is the
# signal worth surfacing and worth a non-zero exit for the scheduler/doctor.
remaining=0
for line in "${report[@]}"; do
    case "$line" in
        CVE*) remaining=1 ;;
        FIX*) [[ $line == *"→ 0 fixable"* ]] || remaining=1 ;;
    esac
done

if (( actionable )); then
    if (( fix && acted )); then
        _notify "image-audit" "Rebuilt images for CVEs. $([[ $remaining == 1 ]] && echo 'Some remain — see log.' || echo 'All clear now.')"
    else
        _notify "image-audit" "Fixable HIGH/CRITICAL CVEs found. Run image-audit --fix."
    fi
fi

(( remaining == 0 ))
