#!/usr/bin/env bash
# git-identity — choose which 1Password SSH keys sign commits and push,
# for this machine (base) or for repos under a path (overlay), from a
# picker fed by what the agent actually offers.
#
# Usage:
#   git-identity                     interactive; asks base vs overlay
#   git-identity base                this machine's default identity
#   git-identity overlay [DIR]       identity for repos under DIR (includeIf gitdir:)
#   git-identity status              audit, no prompts; exit 1 on problems
#   git-identity list                what the agent offers right now
#
# Example:
#   git-identity overlay ~/go/src/github.com/wealthsimple/
#
# Writes only public material, only to untracked per-machine files:
#   ~/.private/gitconfig[-LABEL]        name, email, signingkey (+ includeIf)
#   ~/.config/1Password/ssh/agent.toml  which keys this Mac's agent serves, in order
#   ~/.config/git/allowed_signers       so your own signatures verify
# Never touches ~/.ssh. Runs on the bash macOS ships (3.2) so it works
# before brew has installed anything; fzf is used when present.

set -euo pipefail

DOTFILES="${DOTFILES:-$HOME/.dotfiles}"
ONE_P_SOCK="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
PRIV="$HOME/.private"
BASE_FILE="$PRIV/gitconfig"
EXAMPLE="$DOTFILES/gitconfig.private.example"
SIGN_PROG="$DOTFILES/bin/git-ssh-sign"
AGENT_TOML="$HOME/.config/1Password/ssh/agent.toml"
SIGNERS="$HOME/.config/git/allowed_signers"
DEFAULT_OVERLAY_DIR="~/go/src/github.com/wealthsimple/"
TILDE='~'   # bash tilde-expands a bare ~ in a substitution replacement

bold=$'\033[1m'; dim=$'\033[2m'; blue=$'\033[1;34m'; green=$'\033[32m'
yellow=$'\033[33m'; red=$'\033[31m'; reset=$'\033[0m'
[[ -t 1 ]] || { bold=; dim=; blue=; green=; yellow=; red=; reset=; }

step() { printf '\n%s==>%s %s%s%s\n' "$blue" "$reset" "$bold" "$*" "$reset"; }
info() { printf '    %s\n' "$*"; }
ok()   { printf '    %sok%s   %s\n' "$green" "$reset" "$*"; }
warn() { printf '    %swarn%s %s\n' "$yellow" "$reset" "$*" >&2; }
die()  { printf '%serror%s %s\n' "$red" "$reset" "$*" >&2; exit 1; }

TMP="$(mktemp -d "${TMPDIR:-/tmp}/git-identity.XXXXXX")"
trap 'rm -rf "$TMP"' EXIT

# ------------------------------------------------------------- the agent

SOCK=""
agent_sock() {
    if [[ -S $ONE_P_SOCK ]]; then SOCK=$ONE_P_SOCK; return 0; fi
    # Over ssh the forwarded agent is the one that holds the keys.
    if [[ -n ${SSH_CONNECTION:-} && -n ${SSH_AUTH_SOCK:-} && -S ${SSH_AUTH_SOCK} ]]; then
        SOCK=$SSH_AUTH_SOCK; return 0
    fi
    return 1
}

# Parallel arrays — the bash macOS ships has no associative arrays.
K_TYPE=(); K_MAT=(); K_NAME=(); K_FP=(); K_BITS=()
AGENT_ERR=""
load_keys() {
    K_TYPE=(); K_MAT=(); K_NAME=(); K_FP=(); K_BITS=(); AGENT_ERR=""
    if ! agent_sock; then
        AGENT_ERR="no 1Password agent socket — 1Password → Settings → Developer → Use the SSH agent"
        return 1
    fi
    local out rc=0
    out="$(SSH_AUTH_SOCK=$SOCK ssh-add -L 2>&1)" || rc=$?
    if (( rc != 0 )); then
        case $out in
            *"no identities"*) AGENT_ERR="agent is up but offers no keys — unlock 1Password, or agent.toml names nothing that exists" ;;
            *) AGENT_ERR="cannot talk to the agent (${out:-exit $rc}) — unlock or restart 1Password" ;;
        esac
        return 1
    fi
    local line type rest mat name fpline
    while IFS= read -r line; do
        [[ -n $line ]] || continue
        type=${line%% *}; rest=${line#* }
        if [[ $rest == *" "* ]]; then mat=${rest%% *}; name=${rest#* }
        else mat=$rest; name=""; fi
        printf '%s %s %s\n' "$type" "$mat" "$name" >"$TMP/key.pub"
        fpline="$(ssh-keygen -lf "$TMP/key.pub" 2>/dev/null || true)"
        K_TYPE+=("$type"); K_MAT+=("$mat"); K_NAME+=("${name:-(unnamed $type key)}")
        K_BITS+=("${fpline%% *}")
        fpline=${fpline#* }; K_FP+=("${fpline%% *}")
    done <<<"$out"
    (( ${#K_TYPE[@]} > 0 ))
}

short_type() {
    case $1 in
        ssh-ed25519) echo ed25519 ;; ssh-rsa) echo rsa ;;
        ecdsa-*) echo ecdsa ;; sk-*) echo fido ;; *) echo "$1" ;;
    esac
}

# Index of the agent key whose base64 body is $1, or nothing.
key_index() {
    local i
    for (( i = 0; i < ${#K_MAT[@]}; i++ )); do
        [[ ${K_MAT[$i]} == "$1" ]] && { echo "$i"; return 0; }
    done
    return 1
}

# Two vault items with one title make an agent.toml entry ambiguous.
name_is_dup() {
    local i n=0
    for (( i = 0; i < ${#K_NAME[@]}; i++ )); do
        [[ ${K_NAME[$i]} == "$1" ]] && n=$(( n + 1 ))
    done
    (( n > 1 ))
}

toml_items() {
    [[ -f $AGENT_TOML ]] || return 0
    sed -n 's/^[[:space:]]*item[[:space:]]*=[[:space:]]*"\(.*\)".*/\1/p' "$AGENT_TOML"
}

# ------------------------------------------------------ current config

# user.signingkey may be literal material, a key:: literal, or a .pub path.
# Prints the base64 body, or nothing.
signingkey_body() {
    local key=${1#key::}
    if [[ $key == ssh-* || $key == ecdsa-* || $key == sk-* ]]; then
        key=${key#* }; echo "${key%% *}"
    elif [[ -r ${key/#\~/$HOME} ]]; then
        head -1 "${key/#\~/$HOME}" | cut -d' ' -f2
    fi
}

# "DIR<TAB>FILE" per includeIf gitdir: overlay, wherever it is declared.
list_overlays() {
    git config --show-origin --get-regexp '^includeif\.gitdir(/i)?:.*\.path$' 2>/dev/null \
    | while IFS= read -r line; do
        line=${line#*$'\t'}
        local key=${line% *} file=${line##* }
        key=${key%.path}; key=${key#includeif.gitdir:}; key=${key#includeif.gitdir/i:}
        printf '%s\t%s\n' "$key" "$file"
    done
}

# Which identities currently use key $1 (by body). One line, or empty.
uses_of() {
    local out="" body
    if [[ -f $BASE_FILE ]]; then
        body="$(signingkey_body "$(git config --file "$BASE_FILE" --get user.signingkey || true)")"
        [[ $body == "$1" ]] && out="base signing"
    fi
    local dir file
    while IFS=$'\t' read -r dir file; do
        [[ -f ${file/#\~/$HOME} ]] || continue
        body="$(signingkey_body "$(git config --file "${file/#\~/$HOME}" --get user.signingkey || true)")"
        [[ $body == "$1" ]] && out="${out:+$out, }signing under $dir"
        local cmd; cmd="$(git config --file "${file/#\~/$HOME}" --get core.sshCommand || true)"
        if [[ $cmd == *IdentityFile=* ]]; then
            local pub=${cmd#*IdentityFile=}; pub=${pub%% *}
            [[ -r ${pub/#\~/$HOME} && $(cut -d' ' -f2 "${pub/#\~/$HOME}") == "$1" ]] \
                && out="${out:+$out, }pushing under $dir"
        fi
    done < <(list_overlays)
    printf '%s' "$out"
}

# ------------------------------------------------------------- pickers

have_fzf() { command -v fzf >/dev/null 2>&1; }

# One preview file per key, so fzf's preview is a plain `cat`.
write_previews() {
    mkdir -p "$TMP/preview"
    local i uses listed
    for (( i = 0; i < ${#K_TYPE[@]}; i++ )); do
        uses="$(uses_of "${K_MAT[$i]}")"
        if [[ -f $AGENT_TOML ]]; then
            if toml_items | grep -qxF "${K_NAME[$i]}"; then listed="listed"; else listed="NOT listed (agent will drop it on reload)"; fi
        else listed="no agent.toml — every vault key is offered"; fi
        {
            printf '%s%s%s\n\n' "$bold" "${K_NAME[$i]}" "$reset"
            printf 'type         %s (%s bits)\n' "$(short_type "${K_TYPE[$i]}")" "${K_BITS[$i]}"
            printf 'fingerprint  %s\n' "${K_FP[$i]}"
            printf 'agent.toml   %s\n' "$listed"
            printf 'used by      %s\n' "${uses:-nothing yet}"
            name_is_dup "${K_NAME[$i]}" && printf '\n%sduplicate title%s — agent.toml needs vault = "…" to tell them apart\n' "$yellow" "$reset"
            printf '\n%s%s %s…%s\n' "$dim" "${K_TYPE[$i]}" "${K_MAT[$i]:0:24}" "$reset"
        } >"$TMP/preview/$i.txt"
    done
}

# Lines on stdin as "id<TAB>label". Prints the chosen id(s), one per line.
# $1 header, $2 prompt, $3 "multi" for multi-select.
pick() {
    local header=$1 prompt=$2 multi=${3:-}
    if have_fzf; then
        local args=(--delimiter=$'\t' --with-nth=2.. --height=70% --reverse --border
                    --header="$header" --prompt="$prompt> " --no-info
                    --preview="cat $TMP/preview/{1}.txt 2>/dev/null || echo"
                    --preview-window=right:55%:wrap)
        [[ $multi == multi ]] && args+=(--multi --marker='✓ ' --bind='tab:toggle+down')
        fzf "${args[@]}" | cut -f1
    else
        pick_select "$header" "$prompt" "$multi"
    fi
}

# `select` fallback for a machine that has no fzf yet.
pick_select() {
    local header=$1 prompt=$2 multi=${3:-} id label ids=() labels=() chosen=()
    while IFS=$'\t' read -r id label; do ids+=("$id"); labels+=("$label"); done
    printf '\n%s\n' "$header" >&2
    if [[ $multi != multi ]]; then
        PS3="$prompt> "
        select label in "${labels[@]}"; do
            [[ -n $label ]] && { echo "${ids[$(( REPLY - 1 ))]}"; return 0; }
        done </dev/tty
        return 1
    fi
    PS3="$prompt (number to toggle, empty to finish)> "
    local i mark
    while :; do
        for (( i = 0; i < ${#labels[@]}; i++ )); do
            mark=" "; printf '%s\n' "${chosen[@]-}" | grep -qx "${ids[$i]}" && mark="✓"
            printf ' %2d) %s %s\n' "$(( i + 1 ))" "$mark" "${labels[$i]}" >&2
        done
        printf '%s' "$PS3" >&2
        IFS= read -r REPLY </dev/tty || return 1
        [[ -z $REPLY ]] && break
        [[ $REPLY =~ ^[0-9]+$ ]] && (( REPLY >= 1 && REPLY <= ${#labels[@]} )) || continue
        id=${ids[$(( REPLY - 1 ))]}
        if printf '%s\n' "${chosen[@]-}" | grep -qx "$id"; then
            local keep=() c
            for c in "${chosen[@]-}"; do [[ $c == "$id" ]] || keep+=("$c"); done
            chosen=("${keep[@]-}")
        else chosen+=("$id"); fi
    done
    printf '%s\n' "${chosen[@]-}" | grep -v '^$' || true
}

key_lines() {   # "idx<TAB>name   type" for every agent key
    local i
    for (( i = 0; i < ${#K_TYPE[@]}; i++ )); do
        printf '%s\t%-34s %s\n' "$i" "${K_NAME[$i]}" "$(short_type "${K_TYPE[$i]}")"
    done
}

ask() {   # ask "Prompt" "default" -> REPLY
    local prompt=$1 default=${2:-}
    if [[ -n $default ]]; then
        IFS= read -r -e -p "$prompt [$default]: " REPLY </dev/tty || true
        [[ -n $REPLY ]] || REPLY=$default
    else
        IFS= read -r -e -p "$prompt: " REPLY </dev/tty || true
    fi
}

confirm() {   # confirm "Question" [default y|n]
    local d=${2:-y} REPLY
    IFS= read -r -p "$1 [$( [[ $d == y ]] && echo Y/n || echo y/N )] " REPLY </dev/tty || true
    REPLY=${REPLY:-$d}
    [[ $REPLY == [Yy]* ]]
}

# --------------------------------------------------------------- writes

git_set() { git config --file "$1" "$2" "$3"; }

write_base() {   # NAME EMAIL SIGN_IDX
    local name=$1 email=$2 s=$3
    mkdir -p "$PRIV"; chmod 700 "$PRIV"
    if [[ ! -f $BASE_FILE ]]; then
        cp "$EXAMPLE" "$BASE_FILE"
        info "created $BASE_FILE from gitconfig.private.example"
    fi
    git_set "$BASE_FILE" user.name "$name"
    git_set "$BASE_FILE" user.email "$email"
    git_set "$BASE_FILE" user.signingkey "${K_TYPE[$s]} ${K_MAT[$s]} ${K_NAME[$s]}"
    git_set "$BASE_FILE" gpg.format ssh
    # The wrapper falls back to ssh-keygen where op-ssh-sign does not
    # exist (containers, Linux), so a hardcoded 1Password path or the
    # template placeholder both get replaced. Anything else is yours.
    local prog; prog="$(git config --file "$BASE_FILE" --get gpg.ssh.program || true)"
    case $prog in
        ""|*YOUR_USER*|*/op-ssh-sign) git_set "$BASE_FILE" gpg.ssh.program "$SIGN_PROG" ;;
    esac
    chmod 600 "$BASE_FILE"
    ok "$BASE_FILE  signs with ${K_NAME[$s]}"
}

write_overlay() {   # DIR LABEL NAME EMAIL SIGN_IDX AUTH_IDX-or-empty
    local dir=$1 label=$2 name=$3 email=$4 s=$5 a=${6:-}
    local file="$PRIV/gitconfig-$label" file_tilde="~/.private/gitconfig-$label"
    mkdir -p "$PRIV"; chmod 700 "$PRIV"
    [[ -f $file ]] || printf '# %s — identity for repos under %s. Managed by git-identity.\n' "$label" "$dir" >"$file"
    git_set "$file" user.name "$name"
    git_set "$file" user.email "$email"
    git_set "$file" user.signingkey "${K_TYPE[$s]} ${K_MAT[$s]} ${K_NAME[$s]}"
    if [[ -n $a ]]; then
        # ssh cannot see git paths, so a per-path push key needs a
        # selector. It is the PUBLIC key; ssh uses it to ask the agent for
        # the private half. Kept in ~/.private, never ~/.ssh.
        local pub="$PRIV/$label.pub"
        printf '%s %s %s\n' "${K_TYPE[$a]}" "${K_MAT[$a]}" "${K_NAME[$a]}" >"$pub"
        chmod 600 "$pub"
        git_set "$file" core.sshCommand "ssh -o IdentitiesOnly=yes -o IdentityFile=~/.private/$label.pub"
    else
        git config --file "$file" --unset core.sshCommand 2>/dev/null || true
    fi
    chmod 600 "$file"
    ok "$file  signs with ${K_NAME[$s]}${a:+, pushes with ${K_NAME[$a]}}"

    # The tracked .gitconfig may already include THIS file for the dir.
    # If nothing does, nested includes are fine, so it goes in the
    # untracked base file.
    if declared_overlay_files "$dir" | grep -qxF -e "$file_tilde" -e "$file"; then
        ok "includeIf gitdir:$dir -> $file_tilde already declared"
    else
        [[ -f $BASE_FILE ]] || { cp "$EXAMPLE" "$BASE_FILE"; chmod 600 "$BASE_FILE"; }
        git_set "$BASE_FILE" "includeIf.gitdir:$dir.path" "$file_tilde"
        ok "includeIf gitdir:$dir -> $file_tilde  (in $BASE_FILE)"
    fi
}

declared_overlay_files() {   # DIR -> every path already included for it
    git config --get-all "includeIf.gitdir:$1.path" 2>/dev/null || true
}

write_signers() {   # EMAIL SIGN_IDX
    local line="$1 ${K_TYPE[$2]} ${K_MAT[$2]}"
    mkdir -p "$(dirname "$SIGNERS")"
    if [[ -f $SIGNERS ]] && grep -qxF "$line" "$SIGNERS"; then
        ok "allowed_signers already lists it"
    else
        printf '%s\n' "$line" >>"$SIGNERS"
        ok "allowed_signers += $1"
    fi
}

write_toml() {   # ordered indices...
    mkdir -p "$(dirname "$AGENT_TOML")"
    if [[ -f $AGENT_TOML ]]; then
        cp "$AGENT_TOML" "$AGENT_TOML.bak-$(date +%Y%m%d-%H%M%S)"
    fi
    {
        printf '# Written by git-identity. ONLY the items below are offered by the\n'
        printf '# 1Password SSH agent on this Mac, in this order. Reload: lock and\n'
        printf '# unlock 1Password, or restart it. Regenerate: git-identity base\n'
        local i
        for i in "$@"; do
            printf '\n[[ssh-keys]]\nitem = "%s"\n' "${K_NAME[$i]}"
            name_is_dup "${K_NAME[$i]}" && printf '# vault = "…"   # duplicate title — name the vault\n'
        done
    } >"$AGENT_TOML"
    chmod 600 "$AGENT_TOML"
    ok "$AGENT_TOML  ($# keys, ${K_NAME[$1]} first)"
}

# --------------------------------------------------------------- proofs

verify_sign() {   # SIGN_IDX — raises a 1Password approval prompt
    local s=$1
    printf '%s %s %s\n' "${K_TYPE[$s]}" "${K_MAT[$s]}" "${K_NAME[$s]}" >"$TMP/sign.pub"
    if SSH_AUTH_SOCK=$SOCK ssh-keygen -Y sign -n git -f "$TMP/sign.pub" \
            <<<"git-identity" >"$TMP/sig" 2>"$TMP/sign.err"; then
        ok "signing works with ${K_NAME[$s]}"
    else
        warn "signing FAILED with ${K_NAME[$s]}: $(tail -n1 "$TMP/sign.err")"
        return 1
    fi
}

verify_github() {   # AUTH_IDX
    local a=$1 who greeting
    printf '%s %s %s\n' "${K_TYPE[$a]}" "${K_MAT[$a]}" "${K_NAME[$a]}" >"$TMP/auth.pub"
    greeting="$(SSH_AUTH_SOCK=$SOCK ssh -F /dev/null -o IdentitiesOnly=yes \
        -o IdentityFile="$TMP/auth.pub" -o BatchMode=yes -o ConnectTimeout=8 \
        -o StrictHostKeyChecking=accept-new -T git@github.com 2>&1 || true)"
    case $greeting in
        *"Hi "*"!"*)
            who=${greeting#*Hi }; who=${who%%!*}
            if [[ $who == */* ]]; then
                warn "GitHub sees ${K_NAME[$a]} as a DEPLOY key for $who — pushes will be read-only"
                return 1
            fi
            ok "GitHub greets ${K_NAME[$a]} as $who" ;;
        *"Permission denied"*)
            warn "GitHub rejects ${K_NAME[$a]} — add it under Settings → SSH keys → Authentication"
            return 1 ;;
        *) warn "could not reach GitHub to test ${K_NAME[$a]}: ${greeting:-no output}"; return 1 ;;
    esac
}

# ------------------------------------------------------------- commands

cmd_list() {
    load_keys || die "$AGENT_ERR"
    printf '%s (%s keys)\n' "$SOCK" "${#K_TYPE[@]}"
    local i
    for (( i = 0; i < ${#K_TYPE[@]}; i++ )); do
        printf '  %-34s %-8s %s\n' "${K_NAME[$i]}" "$(short_type "${K_TYPE[$i]}")" "${K_FP[$i]}"
    done
    if [[ -f $AGENT_TOML ]]; then
        printf '\nagent.toml allows (in order):\n'; toml_items | sed 's/^/  /'
    else
        printf '\nno agent.toml — 1Password offers every vault key, its own order\n'
    fi
}

describe_identity() {   # LABEL FILE -> 0 ok, 1 problem
    local label=$1 file=${2/#\~/$HOME} rc=0 email sk body idx
    if [[ ! -f $file ]]; then
        # git skips a missing include silently, so this is only worth a
        # line when it is one of ours: declared, never created.
        case $2 in
            "~/.private/"*|"$PRIV/"*) info "$label  $2 declared but not created — git-identity overlay ${label#under }" ;;
        esac
        return 0
    fi
    email="$(git config --file "$file" --get user.email || true)"
    sk="$(git config --file "$file" --get user.signingkey || true)"
    [[ -n $email ]] || { warn "$label  no user.email in $2"; rc=1; }
    if [[ -z $sk ]]; then
        info "$label  ${email:-?}  unsigned commits"
    else
        body="$(signingkey_body "$sk")"
        if [[ -n $body ]] && idx="$(key_index "$body")"; then
            ok "$label  ${email:-?}  signs with ${K_NAME[$idx]}"
        else
            sk=${sk#key::}
            warn "$label  ${email:-?}  signing key '${sk##* }' is NOT offered by the agent"; rc=1
        fi
    fi
    local cmd; cmd="$(git config --file "$file" --get core.sshCommand || true)"
    if [[ $cmd == *IdentityFile=* ]]; then
        local pub=${cmd#*IdentityFile=}; pub=${pub%% *}
        if [[ -r ${pub/#\~/$HOME} ]] && idx="$(key_index "$(cut -d' ' -f2 "${pub/#\~/$HOME}")")"; then
            info "$label  pushes with ${K_NAME[$idx]}"
        else
            warn "$label  core.sshCommand names $pub, which is missing or not in the agent"; rc=1
        fi
    fi
    return $rc
}

cmd_status() {
    local failed=0
    step "Identity"
    if ! load_keys; then warn "$AGENT_ERR"; failed=1; fi

    if [[ -f $BASE_FILE ]]; then
        describe_identity "base" "$BASE_FILE" || failed=1
    else
        warn "no $BASE_FILE — every commit fails on 'empty ident'. Run: git-identity base"; failed=1
    fi
    local dir file n=0
    while IFS=$'\t' read -r dir file; do
        [[ -n $dir ]] || continue
        n=$(( n + 1 ))
        describe_identity "under $dir" "$file" || failed=1
    done < <(list_overlays)
    (( n )) || info "no per-path overlays (git-identity overlay DIR adds one)"

    step "Key order"
    if [[ -f $AGENT_TOML ]]; then
        local first item missing=0
        first="$(toml_items | head -1)"
        while IFS= read -r item; do
            [[ -n $item ]] || continue
            if (( ${#K_NAME[@]} )) && ! printf '%s\n' "${K_NAME[@]}" | grep -qxF "$item"; then
                warn "agent.toml lists \"$item\" but the agent does not offer it"; missing=1
            fi
        done < <(toml_items)
        (( missing )) && failed=1
        ok "agent.toml pins $(toml_items | grep -c .) key(s), \"$first\" first"
    elif (( ${#K_NAME[@]} )); then
        info "no agent.toml — 1Password offers all ${#K_NAME[@]} keys in its own order; \"${K_NAME[0]}\" goes first"
        info "  pin the order: git-identity base"
    fi
    # IdentitiesOnly with no IdentityFile in the same Host block: ssh offers
    # only default key files, none of which exist here, so it offers nothing.
    local host
    while IFS= read -r host; do
        [[ -n $host ]] || continue
        warn "~/.ssh/config: Host $host sets IdentitiesOnly without an IdentityFile — ssh offers no key at all there"; failed=1
    done < <(awk '
        tolower($1)=="host" { if (only && !file) print h; h=$2; only=0; file=0; next }
        tolower($1)=="identitiesonly" && tolower($2)=="yes" { only=1 }
        tolower($1)=="identityfile" { file=1 }
        END { if (only && !file) print h }' "$HOME/.ssh/config" 2>/dev/null)
    if grep -qs '^[[:space:]]*IdentityFile' "$HOME/.ssh/config"; then
        local pub
        while IFS= read -r pub; do
            pub=${pub/#\~/$HOME}
            [[ -r $pub ]] || { warn "~/.ssh/config names $pub, which does not exist — with IdentitiesOnly that blocks every push"; failed=1; }
        done < <(sed -n 's/^[[:space:]]*IdentityFile[[:space:]]*//p' "$HOME/.ssh/config")
    fi

    return $failed
}

cmd_pick() {   # SCOPE [DIR]
    local scope=${1:-} dir=${2:-}
    [[ -t 0 && -t 1 ]] || die "interactive; run it from a terminal (status/list work without one)"
    load_keys || die "$AGENT_ERR"
    write_previews

    step "Identity picker"
    info "1Password agent offers ${#K_TYPE[@]} keys"
    if [[ -f $AGENT_TOML ]]; then
        info "agent.toml is filtering: only its $(toml_items | grep -c .) item(s) are visible. To pick"
        info "  from everything, move it aside and lock/unlock 1Password first."
    fi
    have_fzf || info "(no fzf yet — numbered menus instead)"

    if [[ -z $scope ]]; then
        scope="$(printf 'base\tBase identity   — every repo on this machine\noverlay\tOverlay         — repos under a path (includeIf gitdir:)\n' \
            | pick "What are you setting up?" "scope" || true)"
        [[ -n $scope ]] || die "nothing chosen"
    fi

    local label="" file_tilde=""
    if [[ $scope == overlay ]]; then
        if [[ -z $dir ]]; then ask "Repos under which directory" "$DEFAULT_OVERLAY_DIR"; dir=$REPLY; fi
        dir=${dir/#$HOME/$TILDE}; [[ $dir == */ ]] || dir="$dir/"
        # Reuse the name .gitconfig already includes for this dir, so the
        # overlay lands in the file git is going to read.
        local guess; guess="$(declared_overlay_files "$dir" | head -1)"
        guess=${guess##*/gitconfig-}
        [[ -n $guess && $guess != */* ]] || guess="$(basename "$dir")"
        ask "Overlay name (file becomes ~/.private/gitconfig-NAME)" "$guess"; label=$REPLY
        file_tilde="~/.private/gitconfig-$label"
    fi

    # Defaults: the overlay's own values, else whatever git resolves now.
    local cur_file="$BASE_FILE"
    [[ $scope == overlay && -f ${file_tilde/#\~/$HOME} ]] && cur_file="${file_tilde/#\~/$HOME}"
    local cur_name cur_email cur_sk
    cur_name="$(git config --file "$cur_file" --get user.name 2>/dev/null || git config --get user.name || true)"
    cur_email="$(git config --file "$cur_file" --get user.email 2>/dev/null || git config --get user.email || true)"
    cur_sk="$(git config --file "$cur_file" --get user.signingkey 2>/dev/null || true)"

    ask "Name" "$cur_name";   local name=$REPLY
    ask "Email" "$cur_email"; local email=$REPLY
    [[ -n $name && -n $email ]] || die "name and email are required"

    local cur_idx="" hdr
    [[ -n $cur_sk ]] && cur_idx="$(key_index "$(signingkey_body "$cur_sk")" || true)"
    hdr="Which key SIGNS commits${label:+ under $dir}?"
    [[ -n $cur_idx ]] && hdr="$hdr   (now: ${K_NAME[$cur_idx]})"
    local s; s="$(key_lines | pick "$hdr" "sign" || true)"
    [[ -n $s ]] || die "no signing key chosen"

    local a=""
    if [[ $scope == base ]]; then
        hdr="Which key AUTHENTICATES to GitHub? It goes first in agent.toml."
        a="$({ printf '%s\tsame as signing (%s)\n' "$s" "${K_NAME[$s]}"; key_lines | grep -v "^$s"$'\t'; } \
            | pick "$hdr" "push" || true)"
    else
        hdr="Push key for repos under $dir? 'agent order' = whatever agent.toml puts first."
        a="$({ printf -- '-\tagent order (no per-path selector)\n'; key_lines; } | pick "$hdr" "push" || true)"
        [[ $a == - ]] && a=""
    fi
    [[ $scope == base && -z $a ]] && a=$s

    # Base only: the agent.toml allowlist. Overlays never touch it.
    local order=()
    if [[ $scope == base ]]; then
        order=("$a"); [[ $a != "$s" ]] && order+=("$s")
        local others=() i
        for (( i = 0; i < ${#K_TYPE[@]}; i++ )); do
            [[ $i == "$a" || $i == "$s" ]] || others+=("$i")
        done
        if (( ${#others[@]} )); then
            echo
            if confirm "Keep the other ${#others[@]} key(s) available on this machine?" y; then
                order+=("${others[@]}")
            else
                local keep
                keep="$(for i in "${others[@]}"; do key_lines | grep "^$i"$'\t'; done \
                    | pick "Which OTHER keys may this Mac's agent offer? (TAB marks, Enter confirms; none is fine)" "keep" multi || true)"
                [[ -n $keep ]] && while IFS= read -r i; do order+=("$i"); done <<<"$keep"
            fi
        fi
    fi

    step "Plan"
    if [[ $scope == base ]]; then
        info "$BASE_FILE"
        info "  user.name        $name"
        info "  user.email       $email"
        info "  user.signingkey  ${K_NAME[$s]}"
        info "$AGENT_TOML"
        for i in "${order[@]}"; do info "  ${K_NAME[$i]}"; done
        info "  ${dim}(${#K_TYPE[@]} keys offered now → ${#order[@]} after 1Password reloads)${reset}"
    else
        info "$file_tilde  (includeIf gitdir:$dir)"
        info "  user.name        $name"
        info "  user.email       $email"
        info "  user.signingkey  ${K_NAME[$s]}"
        [[ -n $a ]] && info "  core.sshCommand  IdentitiesOnly + ~/.private/$label.pub (${K_NAME[$a]})"
    fi
    info "$SIGNERS  += $email"
    echo
    confirm "Write these?" y || die "aborted, nothing written"

    step "Writing"
    if [[ $scope == base ]]; then
        write_base "$name" "$email" "$s"
        write_toml "${order[@]}"
    else
        write_overlay "$dir" "$label" "$name" "$email" "$s" "$a"
    fi
    write_signers "$email" "$s"

    step "Proving it"
    if [[ -n ${GIT_IDENTITY_SKIP_PROOFS:-} ]]; then
        info "skipped (GIT_IDENTITY_SKIP_PROOFS)"
    else
        info "1Password will ask you to approve one signature."
        verify_sign "$s" || true
        verify_github "${a:-$s}" || true
    fi

    echo
    if [[ $scope == base ]]; then
        printf '%sNext:%s lock and unlock 1Password (or restart it) so the agent reloads agent.toml,\n' "$bold" "$reset"
        printf 'then run: git-identity status\n'
    else
        # includeIf gitdir: only matches from inside a worktree, so find one.
        local probe; probe="$(find "${dir/#\~/$HOME}" -maxdepth 3 -name .git -print 2>/dev/null | head -1)"
        if [[ -n $probe ]]; then
            probe=${probe%/.git}
            local seen; seen="$(git -C "$probe" config --get user.email 2>/dev/null || true)"
            [[ $seen == "$email" ]] && ok "git resolves $email inside ${probe/#$HOME/$TILDE}" \
                || warn "git inside ${probe/#$HOME/$TILDE} resolves '${seen:-nothing}', not $email — check the includeIf path matches the real (symlink-free) location"
        fi
        printf '%sNext:%s commit inside a repo under %s and check `git log --show-signature -1`\n' "$bold" "$reset" "$dir"
    fi
}

case ${1:-} in
    ""|pick)        cmd_pick "" ;;
    base)           cmd_pick base ;;
    overlay)        cmd_pick overlay "${2:-}" ;;
    status)         cmd_status ;;
    list)           cmd_list ;;
    -h|--help|help) sed -n '2,/^$/p' "$0" | sed 's/^# \{0,1\}//' ;;
    *)              die "usage: git-identity [base|overlay [DIR]|status|list]" ;;
esac
