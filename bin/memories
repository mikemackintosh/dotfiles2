#!/usr/bin/env bash
# memories — browse, create, and search Claude Code project memories.
#
#   memories                     # fzf-browse this dir's project memories
#   memories -a                  # fzf-browse memories across every project
#   memories new <type> <name>   # scaffold a new memory and open it in $EDITOR
#                                #   type ∈ {user, feedback, project, reference}
#                                #   name = kebab-case slug
#   memories grep <pattern>      # ripgrep (or grep) across every project's memories
#
# Inside the fzf browser:
#   enter      open the memory in $EDITOR
#   ctrl-y     copy the memory's path to the clipboard (pbcopy)
#   ctrl-/     toggle the preview pane

set -euo pipefail

MEMORY_ROOT="$HOME/.claude/projects"
SELF="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)/$(basename "${BASH_SOURCE[0]}")"

# ---------- frontmatter parsing ----------
# Pull a single top-level or once-nested key from the YAML frontmatter.
fm_field() {
    awk -v k="$2" '
        /^---$/ { n++; if (n >= 2) exit; next }
        n == 1 {
            line = $0
            sub(/^[[:space:]]+/, "", line)
            if (line ~ "^" k ":") {
                sub("^" k ":[[:space:]]*", "", line)
                gsub(/^["'\'']|["'\'']$/, "", line)
                print line
                exit
            }
        }
    ' "$1"
}

badge_for_type() {
    case "$1" in
        user)      printf '\e[1;36m[%s]\e[0m' "$1" ;;  # cyan
        feedback)  printf '\e[1;33m[%s]\e[0m' "$1" ;;  # yellow
        project)   printf '\e[1;32m[%s]\e[0m' "$1" ;;  # green
        reference) printf '\e[1;35m[%s]\e[0m' "$1" ;;  # magenta
        *)         printf '\e[1;37m[%s]\e[0m' "$1" ;;
    esac
}

# ---------- listing ----------
list_for_dir() {
    local memdir="$1" f base name desc type badge
    [[ -d $memdir ]] || return 0
    for f in "$memdir"/*.md; do
        [[ -f $f ]] || continue
        base=$(basename "$f")
        [[ $base == "MEMORY.md" ]] && continue
        name=$(fm_field "$f" name)
        desc=$(fm_field "$f" description)
        type=$(fm_field "$f" type)
        [[ -z $name ]] && name="${base%.md}"
        [[ -z $type ]] && type="?"
        badge=$(badge_for_type "$type")
        # tab-separated: <path>\t<displayed columns>
        printf '%s\t%s  \e[1m%-32s\e[0m \e[2m%s\e[0m\n' \
            "$f" "$badge" "$name" "$desc"
    done
}

list_all() {
    local d
    for d in "$MEMORY_ROOT"/*/memory; do
        list_for_dir "$d"
    done
}

# ---------- preview ----------
render_md() {
    if command -v glow >/dev/null 2>&1; then
        glow -s dark -
    elif command -v bat >/dev/null 2>&1; then
        bat --color=always --language=markdown --plain
    else
        # Hand-rolled fallback. Headings, list bullets, **bold leaders**.
        awk '
            /^# /     { printf "\033[1;36m%s\033[0m\n", $0; next }
            /^## /    { printf "\033[1;35m%s\033[0m\n", $0; next }
            /^### /   { printf "\033[1;33m%s\033[0m\n", $0; next }
            /^- /     { printf "  \033[36m•\033[0m %s\n", substr($0, 3); next }
            /^[[:space:]]*\*\*[^*]+:\*\*/ {
                gsub(/\*\*/, "")
                printf "\033[1m%s\033[0m\n", $0
                next
            }
            { print }
        '
    fi
}

preview_file() {
    local f="$1" name desc type badge
    [[ -f $f ]] || { echo "(file not found: $f)"; return; }
    name=$(fm_field "$f" name)
    desc=$(fm_field "$f" description)
    type=$(fm_field "$f" type)
    [[ -z $name ]] && name="$(basename "${f%.md}")"
    [[ -z $type ]] && type="?"
    badge=$(badge_for_type "$type")

    printf '%s \e[1m%s\e[0m\n' "$badge" "$name"
    [[ -n $desc ]] && printf '\e[2m%s\e[0m\n' "$desc"
    printf '\e[2m%s\e[0m\n' "$f"
    printf -- '─%.0s' {1..60}
    printf '\n\n'

    awk '/^---$/{n++; next} n>=2{print}' "$f" | render_md
}

# ---------- subcommand: new ----------
cmd_new() {
    local type="${1:-}" name="${2:-}"
    case "$type" in
        user|feedback|project|reference) ;;
        *)
            echo "Usage: memories new <type> <name>" >&2
            echo "  type ∈ {user, feedback, project, reference}" >&2
            echo "  name = kebab-case slug (letters, digits, hyphens)" >&2
            exit 2 ;;
    esac
    if [[ ! $name =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
        echo "memories new: name must be kebab-case (got: '$name')" >&2
        exit 2
    fi

    local slug="${PWD//\//-}"
    local memdir="$MEMORY_ROOT/$slug/memory"
    mkdir -p "$memdir"

    local file="$memdir/${type}_${name//-/_}.md"
    if [[ -e $file ]]; then
        echo "memories new: already exists: $file" >&2
        exit 1
    fi

    cat > "$file" <<EOF
---
name: ${type}-${name}
description: TODO one-line summary
metadata:
  type: ${type}
---

TODO body
EOF

    # Append to MEMORY.md index, creating it if absent.
    local index="$memdir/MEMORY.md"
    local rel="${file#$memdir/}"
    printf -- '- [TODO title](%s) — TODO one-line hook\n' "$rel" >> "$index"

    echo "Created $file"
    echo "Indexed in $index (last line — update title + hook)"
    exec "${EDITOR:-vim}" "$file"
}

# ---------- subcommand: grep ----------
cmd_grep() {
    local pattern="${1:-}"
    if [[ -z $pattern ]]; then
        echo "Usage: memories grep <pattern>" >&2
        exit 2
    fi
    shift
    local grep_cmd=(grep -rn --color=always --include='*.md')
    if command -v rg >/dev/null 2>&1; then
        grep_cmd=(rg --color=always --line-number --glob '*.md')
    fi
    # Pass through extra flags after the pattern.
    "${grep_cmd[@]}" "$@" -- "$pattern" "$MEMORY_ROOT"/*/memory 2>/dev/null \
        | sed "s#$MEMORY_ROOT/##"
}

# ---------- entry point ----------
case "${1:-}" in
    __preview)
        preview_file "$2"
        exit 0
        ;;
    -h|--help)
        sed -n '2,15p' "$SELF" | sed 's/^# \{0,1\}//'
        exit 0
        ;;
    new)
        shift
        cmd_new "$@"
        exit 0
        ;;
    grep)
        shift
        cmd_grep "$@"
        exit $?
        ;;
esac

scope="cwd"
case "${1:-}" in
    -a|--all) scope="all" ;;
esac

if [[ $scope == "all" ]]; then
    rows=$(list_all)
    header="memories: all projects"
else
    slug="${PWD//\//-}"
    memdir="$MEMORY_ROOT/$slug/memory"
    if [[ ! -d $memdir ]]; then
        echo "No memories for this directory." >&2
        echo "Expected: $memdir" >&2
        echo "Try: memories -a" >&2
        exit 1
    fi
    rows=$(list_for_dir "$memdir")
    header="memories: $PWD"
fi

if [[ -z $rows ]]; then
    echo "No memories found." >&2
    exit 1
fi

editor="${EDITOR:-vim}"

printf '%s\n' "$rows" | fzf \
    --ansi \
    --delimiter=$'\t' \
    --with-nth=2.. \
    --preview="$SELF __preview {1}" \
    --preview-window=right:60%:wrap \
    --header="$header
enter: edit · ctrl-y: copy path · ctrl-/: toggle preview" \
    --bind="enter:execute($editor {1} < /dev/tty > /dev/tty)" \
    --bind="ctrl-y:execute-silent(printf '%s' {1} | pbcopy)+abort" \
    --bind="ctrl-/:toggle-preview"
