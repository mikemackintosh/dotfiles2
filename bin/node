#!/usr/bin/env bash
# node — run Node.js in Docker instead of a local install.
#
# We deliberately don't install Node on the host. This shim makes `node`
# transparent so tools that shell out to it (CocoaPods, Metro, RN CLI) just
# work. The host filesystem is mounted at an IDENTICAL path inside the
# container, so `require.resolve(...)` and any emitted paths are valid on the
# host too — which is exactly what CocoaPods' Podfile relies on.
#
# Override the image:  NODE_DOCKER_IMAGE=node:22 node ...
# Extra docker args:   NODE_DOCKER_ARGS=(--network host) node ...
#
# See also: the `k` kubectl shim (zsh/kube.zsh) — same containerized approach.

set -euo pipefail

# Re-entrancy guard: when we're ALREADY inside the container (the outer run
# sets NODE_SHIM_INNER), exec the container's real Node. Tools like RN's
# bundle.js shell out to "$NODE_BINARY ... cli.js config" — if that re-ran the
# Docker shim from inside the container it would try (and fail) to spawn Docker
# again. Inside the container we just want the real node.
if [[ -n "${NODE_SHIM_INNER:-}" ]]; then
  for real in /usr/local/bin/node /usr/bin/node; do
    [[ -x "$real" ]] && exec "$real" "$@"
  done
  exec node "$@"   # last resort via PATH
fi

image="${NODE_DOCKER_IMAGE:-node:20}"

# Resolve docker even under a minimal PATH (e.g. Xcode build phases, which
# often omit /usr/local/bin where Docker Desktop's CLI symlink lives).
docker_bin="$(command -v docker 2>/dev/null || true)"
if [[ -z "$docker_bin" ]]; then
  for c in /usr/local/bin/docker /opt/homebrew/bin/docker "$HOME/.docker/bin/docker"; do
    [[ -x "$c" ]] && { docker_bin="$c"; break; }
  done
fi
if [[ -z "$docker_bin" ]]; then
  echo "node(shim): docker not found on PATH or in known locations — cannot run Node." >&2
  exit 127
fi

# Allow callers to inject extra `docker run` args via a NODE_DOCKER_ARGS array.
extra=()
if [[ -n "${NODE_DOCKER_ARGS+x}" ]]; then
  extra=("${NODE_DOCKER_ARGS[@]}")
fi

# Mount $HOME at the same path and run as the host user so resolved paths
# stay host-valid and any emitted files aren't root-owned.
exec "$docker_bin" run --rm -i \
  -u "$(id -u):$(id -g)" \
  -v "$HOME:$HOME" \
  -w "$PWD" \
  -e HOME="$HOME" \
  -e NODE_SHIM_INNER=1 \
  ${extra[@]+"${extra[@]}"} \
  "$image" \
  node "$@"
