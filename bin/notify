#!/usr/bin/env bash
# notify [-q|--quiet] <cmd...> — run a command, signal completion.
# Designed to be reliable on macOS Tahoe where the system silently
# files Notification Center entries without showing banners.
#
# Channels (none of which require macOS notification permission):
#   1. iTerm2 OSC 9 escape sequence — produces an in-iTerm banner.
#   2. `say` TTS — speaks "done" / "failed". Suppress with -q.
#   3. Terminal bell (\a) — always rings.
#
# Examples:
#   notify go test ./...
#   notify -q make build
#
# The command's own exit status is propagated.

set -uo pipefail

speak=1
if [[ ${1:-} == "-q" || ${1:-} == "--quiet" ]]; then
    speak=0
    shift
fi

if [[ $# -eq 0 ]]; then
    echo "usage: notify [-q|--quiet] <cmd...>" >&2
    exit 2
fi

cmd_str="$*"
start=$(date +%s)
"$@"
status=$?
end=$(date +%s)
elapsed=$((end - start))

if (( elapsed >= 60 )); then
    dur=$(printf '%dm%02ds' $((elapsed / 60)) $((elapsed % 60)))
else
    dur="${elapsed}s"
fi

if (( status == 0 )); then
    short="done in $dur"
    speech="done"
else
    short="failed (exit $status) in $dur"
    speech="failed"
fi

# 1. iTerm2 OSC 9 banner. Rendered by iTerm itself; bypasses macOS
#    notification permissions entirely.
if [[ ${TERM_PROGRAM:-} == "iTerm.app" ]]; then
    ( printf '\033]9;%s — %s\007' "$short" "$cmd_str" >/dev/tty ) 2>/dev/null || true
fi

# 2. TTS — detached subshell so the prompt returns immediately.
if (( speak )) && command -v say >/dev/null 2>&1; then
    ( say "$speech" >/dev/null 2>&1 & ) 2>/dev/null || true
fi

# 3. Bell.
( printf '\a' >/dev/tty ) 2>/dev/null || true

exit $status
