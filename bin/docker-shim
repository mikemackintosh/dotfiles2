#!/usr/bin/env bash
# docker-shim — run a language/toolchain binary in Docker instead of installing
# it on the host. These tools are deliberately NOT on this machine; each name
# this script is invoked as ($0) maps to a container image + in-container
# command. Symlink a tool name to this script on $PATH to "install" it:
#
#   ln -s docker-shim bin/npm          # then `npm …` runs in Docker
#
# install.sh creates the known set (node npm npx yarn pnpm corepack bun deno
# python3 python pip3 pip uv uvx poetry ruby gem bundle bundler irb).
#
# Only the PROJECT is mounted — the git toplevel (plus a worktree's common .git),
# else $PWD — at an IDENTICAL path, and we run as the host user, so resolved/
# emitted paths stay valid on the host (CocoaPods' Podfile relies on this) and
# written files aren't root-owned. The rest of $HOME (~/.ssh, ~/.private,
# ~/.aws, …) is not visible: $HOME inside is the `docker-shim-home` volume,
# which holds the tool caches (~/.npm, ~/.cache, ~/.gem, …) between runs.
# ~/.npmrc is mounted read-only for private registries.
#
# Pass host env by NAME:    DOCKER_SHIM_ENV="DATABASE_URL API_KEY" npm start
#                           (nothing is inherited otherwise; values stay off argv)
# Git over 1Password:       DOCKER_SHIM_GIT=1 go get ./…   (forwards the SSH
#                           agent for push/pull/signing; off by default — see below)
# Extra RW mounts:          DOCKER_SHIM_MOUNTS=~/src/lib:~/src/other npm …
# Old whole-$HOME mount:    DOCKER_SHIM_HOME=host npm …
#
# Per-tool image override:  NODE_DOCKER_IMAGE=node:22 node …   (<NAME>_DOCKER_IMAGE)
# Extra `docker run` args:  DOCKER_SHIM_ARGS='--network host' npm …
#                           NODE_DOCKER_ARGS='--add-host x:1.2.3.4' node …
#
# See also: bin/gh (hard block), zsh/kube.zsh (same approach for kubectl).
#
# NOTE: the default python/ruby images are the -slim variants (smaller, and
# already cached on this machine). pip/gem installs that compile native
# extensions may need a fuller image — override e.g. PIP3_DOCKER_IMAGE=python:3.12.

set -euo pipefail

self="$(basename "$0")"

# Re-entrancy guard: inside the container we export DOCKER_SHIM_INNER, so if a
# tool shells back out to this shim by absolute path (e.g. React Native sets
# $NODE_BINARY to the resolved `node` path, which is this script, then re-invokes
# it from inside the container) we run the container's REAL binary instead of
# trying to spawn Docker again.
if [[ -n "${DOCKER_SHIM_INNER:-}" ]]; then
  for d in /usr/local/bin /usr/bin /bin /usr/local/sbin /sbin; do
    [[ -x "$d/$self" ]] && exec "$d/$self" "$@"
  done
  exec "$self" "$@"   # last resort via the container's PATH
fi

# Map the invoked name to a default image and the in-container command. `cmd`'s
# first element becomes the container --entrypoint (this neutralizes any
# ENTRYPOINT baked into images like denoland/deno); the rest are prepended to
# the user's arguments.
# `env` holds NAME=VALUE pairs to pass through with -e (nothing is inherited
# from the host otherwise).
image_default=""
cmd=()
env=()
case "$self" in
  node|npm|npx|corepack|yarn) image_default="node:22" ; cmd=("$self") ;;
  # pnpm isn't preinstalled; activate it via the bundled corepack into a
  # writable, $HOME-mounted dir (persists, so the download happens once).
  pnpm)
    image_default="node:22"
    cmd=(sh -c '
      export COREPACK_HOME="${COREPACK_HOME:-$HOME/.cache/corepack}"
      b="$COREPACK_HOME/bin"; mkdir -p "$b"
      corepack enable pnpm --install-directory "$b" >/dev/null 2>&1 \
        || corepack enable --install-directory "$b" >/dev/null 2>&1
      exec "$b/pnpm" "$@"' pnpm) ;;
  bun)                  image_default="oven/bun:latest"                        ; cmd=(bun) ;;
  deno)                 image_default="denoland/deno:latest"                   ; cmd=(deno) ;;
  python3|python)       image_default="python:3.12-slim"                       ; cmd=(python3) ;;
  pip3|pip)             image_default="python:3.12-slim"                       ; cmd=(pip3) ;;
  uv|uvx)               image_default="ghcr.io/astral-sh/uv:python3.12-bookworm-slim" ; cmd=("$self") ;;
  # poetry has no official image; run it through uv's tool runner.
  poetry)               image_default="ghcr.io/astral-sh/uv:python3.12-bookworm-slim" ; cmd=(uvx poetry) ;;
  ruby|gem|irb)         image_default="ruby:3.3-slim"                          ; cmd=("$self") ;;
  bundle|bundler)       image_default="ruby:3.3-slim"                          ; cmd=(bundle) ;;
  # JetBrains publishes no Kotlin image, and the community ones aren't worth
  # trusting, so bootstrap the official release zip into a $HOME-mounted cache on
  # top of a plain JDK (checksum-verified, downloaded once per version).
  kotlinc|kotlin|kotlinc-jvm|kotlinc-js|kotlinc-wasm|kotlinr|kapt)
    image_default="eclipse-temurin:21-jdk"
    env=(KOTLIN_VERSION="${KOTLIN_VERSION:-2.4.10}")
    cmd=(sh -c '
      set -e
      root="$HOME/.cache/kotlin-compiler/$KOTLIN_VERSION"
      if [ ! -x "$root/kotlinc/bin/$0" ]; then
        url="https://github.com/JetBrains/kotlin/releases/download/v$KOTLIN_VERSION/kotlin-compiler-$KOTLIN_VERSION.zip"
        tmp="$root/.tmp.$$"
        rm -rf "$tmp"; mkdir -p "$tmp"
        echo "$0(shim): fetching kotlin-compiler $KOTLIN_VERSION" >&2
        curl -fsSL -o "$tmp/k.zip" "$url"
        echo "$(curl -fsSL "$url.sha256")  $tmp/k.zip" | sha256sum -c - >/dev/null
        cd "$tmp"
        jar xf k.zip                     # the JDK image has no unzip
        chmod +x kotlinc/bin/*           # jar, unlike unzip, drops the exec bit
        cd - >/dev/null
        mv "$tmp/kotlinc" "$root/kotlinc" 2>/dev/null || true   # lost a race: keep theirs
        rm -rf "$tmp"
      fi
      exec "$root/kotlinc/bin/$0" "$@"' "$self") ;;
  *)
    echo "docker-shim: don't know how to run '$self' — add it to the case in $0." >&2
    exit 127 ;;
esac

# This machine uses pnpm. npm/npx/yarn are refused so an unhardened install
# can't sneak in: pnpm won't run a dependency's build script unless it's
# allowlisted (`pnpm approve-builds`) and won't resolve a version younger than
# minimumReleaseAge, neither of which npm/yarn enforce. pnpm covers the
# workflows — `pnpm install`, `pnpm <script>`, `pnpm dlx <pkg>` for npx.
# Escape hatch for a genuine npm-lockfile-only project: DOCKER_SHIM_ALLOW_NPM=1.
if [[ -z ${DOCKER_SHIM_ALLOW_NPM:-} ]]; then
  case "$self" in
    npm|yarn) echo "$self(shim): this machine uses pnpm — run 'pnpm' instead (or DOCKER_SHIM_ALLOW_NPM=1 $self … for a one-off)." >&2; exit 1 ;;
    npx)      echo "npx(shim): this machine uses pnpm — run 'pnpm dlx' instead (or DOCKER_SHIM_ALLOW_NPM=1 npx … for a one-off)." >&2; exit 1 ;;
  esac
fi

# Dependency install scripts are the supply-chain hole, so they're off unless
# DOCKER_SHIM_ALLOW_SCRIPTS=1. This only bites the npm/yarn escape hatch above;
# pnpm enforces its own allowlist. node/corepack don't install.
case "$self" in
  node|npm|npx|corepack|yarn)
    [[ ${DOCKER_SHIM_ALLOW_SCRIPTS:-} == 1 ]] \
      || env+=(npm_config_ignore_scripts=true YARN_IGNORE_SCRIPTS=true YARN_ENABLE_SCRIPTS=false) ;;
esac

# Resolve docker even under a minimal PATH (e.g. Xcode build phases, which often
# omit /usr/local/bin where Docker Desktop's CLI symlink lives).
docker_bin="$(command -v docker 2>/dev/null || true)"
if [[ -z "$docker_bin" ]]; then
  for c in /usr/local/bin/docker /opt/homebrew/bin/docker "$HOME/.docker/bin/docker"; do
    [[ -x "$c" ]] && { docker_bin="$c"; break; }
  done
fi
if [[ -z "$docker_bin" ]]; then
  echo "$self(shim): docker not found on PATH or in known locations — cannot run." >&2
  exit 127
fi

# Reap orphaned shim-spawned containers. Long-running MCP servers
# (e.g. `@playwright/mcp` under node:22) attach to a parent claude via
# stdio. If claude dies with SIGKILL (container OOM, docker daemon
# restart, ungraceful teardown), `docker run --rm` never fires and the
# MCP container lingers indefinitely — 6 of those piled up on this box,
# each ~100 MiB, contributing to the memory pressure that killed the
# next claude session.
#
# We tag every container we spawn with a lineage label:
#   com.claude-shim.parent-pid=<host PID>        (shim ran on host)
#   com.claude-shim.parent-container=<name>      (shim ran inside a container)
# On each shim invocation, before spawning a new container, sweep the
# labels: kill anything whose parent PID no longer exists on the host,
# or whose parent container is no longer running.
_reap_shim_orphans() {
    local cid pid pcont
    while IFS=$'\t' read -r cid pid; do
        [[ -n $cid && -n $pid ]] || continue
        if ! kill -0 "$pid" 2>/dev/null; then
            "$docker_bin" rm -f "$cid" >/dev/null 2>&1 || true
        fi
    done < <("$docker_bin" ps -a --filter "label=com.claude-shim.parent-pid" \
             --format '{{.ID}}	{{.Label "com.claude-shim.parent-pid"}}' 2>/dev/null)
    while IFS=$'\t' read -r cid pcont; do
        [[ -n $cid && -n $pcont ]] || continue
        if ! "$docker_bin" inspect -f '{{.State.Running}}' "$pcont" 2>/dev/null | grep -q true; then
            "$docker_bin" rm -f "$cid" >/dev/null 2>&1 || true
        fi
    done < <("$docker_bin" ps -a --filter "label=com.claude-shim.parent-container" \
             --format '{{.ID}}	{{.Label "com.claude-shim.parent-container"}}' 2>/dev/null)
}
_reap_shim_orphans

# Per-tool image override: <NAME>_DOCKER_IMAGE (e.g. NODE_DOCKER_IMAGE, PIP3_DOCKER_IMAGE).
name_uc="$(printf '%s' "$self" | tr 'a-z-' 'A-Z_')"
img_var="${name_uc}_DOCKER_IMAGE"
image="${!img_var:-$image_default}"

# Extra `docker run` args, word-split (env vars can't carry bash arrays across a
# process boundary). DOCKER_SHIM_ARGS applies to every tool; <NAME>_DOCKER_ARGS
# is per-tool. Both are optional.
extra=()
[[ -n "${DOCKER_SHIM_ARGS:-}" ]] && extra+=($DOCKER_SHIM_ARGS)
args_var="${name_uc}_DOCKER_ARGS"
args_val="${!args_var:-}"
[[ -n "$args_val" ]] && extra+=($args_val)

run=(run --rm -i)
[[ -t 0 && -t 1 ]] && run+=(-t)               # a TTY when interactive (REPLs)
uid_gid="$(id -u):$(id -g)"
run+=(-u "$uid_gid" -e HOME="$HOME")

# $HOME or one of its ancestors as the "project" would hand all of $HOME back.
_too_wide() { [[ $1 == / || $1 == "$HOME" || $HOME == "$1"/* ]]; }

if [[ ${DOCKER_SHIM_HOME:-} == host ]]; then
  run+=(-v "$HOME:$HOME")
  case "$PWD" in
    "$HOME"|"$HOME"/*) : ;;
    *) run+=(-v "$PWD:$PWD") ;;
  esac
else
  # A named volume, not a host dir: the shim also runs inside claude-in-docker,
  # where a host path it can't mkdir would be auto-created root-owned.
  # volume-nocopy: an empty volume's first mount otherwise takes the
  # mountpoint's owner from the image (root), undoing the chown.
  home_vol=docker-shim-home
  if ! "$docker_bin" volume inspect "$home_vol" >/dev/null 2>&1; then
    "$docker_bin" volume create "$home_vol" >/dev/null
    "$docker_bin" run --rm -u 0 --mount "type=volume,src=$home_vol,dst=/h,volume-nocopy" \
      --entrypoint chown "$image" "$uid_gid" /h
  fi
  run+=(--mount "type=volume,src=$home_vol,dst=$HOME,volume-nocopy")
  [[ -f $HOME/.npmrc ]] && run+=(-v "$HOME/.npmrc:$HOME/.npmrc:ro")

  project="$(git -C "$PWD" rev-parse --show-toplevel 2>/dev/null || true)"
  [[ -n $project ]] && _too_wide "$project" && project=""
  [[ -n $project ]] || project="$PWD"
  if _too_wide "$project"; then
    echo "$self(shim): not mounting $project (it would expose \$HOME); the container sees an empty dir. Run from a project, or DOCKER_SHIM_HOME=host." >&2
  else
    run+=(-v "$project:$project")
    common="$(git -C "$PWD" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
    case "$common" in
      ""|"$project"/*) : ;;
      *) _too_wide "$common" || run+=(-v "$common:$common") ;;
    esac
  fi
  if [[ -n ${DOCKER_SHIM_MOUNTS:-} ]]; then
    IFS=: read -r -a _extra_mounts <<< "$DOCKER_SHIM_MOUNTS"
    for m in "${_extra_mounts[@]}"; do
      [[ -d $m ]] && ! _too_wide "$m" && run+=(-v "$m:$m")
    done
  fi
fi
# Git inside the container. `safe.directory=*` is ALWAYS set: Docker Desktop
# presents the mounted project as root-owned, so without it any git call (a
# `go get`, an npm git dep, a build script) dies with "dubious ownership".
# It only lets git read a tree we already mounted — it exposes nothing.
#
# Signing, push and pull need your 1Password SSH agent, which is OPT-IN via
# DOCKER_SHIM_GIT=1 — forwarding the agent lets anything in the container
# (a postinstall, a transitive `go get`) authenticate and sign AS YOU, which
# is exactly the exposure the volume-$HOME default removes, so it stays off
# unless asked for. On: the agent socket is forwarded at its literal path
# (so ~/.ssh/config's IdentityAgent resolves), op-ssh-sign (macOS-only) is
# swapped for ssh-keygen, and ~/.gitconfig + ~/.private + known_hosts are
# mounted read-only for identity and host verification. The private key
# never leaves 1Password. Needs git + ssh-keygen in the image (node:22 has
# them; the -slim python/ruby images may not).
git_params=('safe.directory=*')
if [[ -n ${DOCKER_SHIM_GIT:-} && ${DOCKER_SHIM_GIT} != 0 ]]; then
  _host_home=0; [[ ${DOCKER_SHIM_HOME:-} == host ]] && _host_home=1
  # ssh (and git over it) calls getpwuid for our uid; the image's passwd DB
  # doesn't know uid 501, so it dies with "No user exists for uid 501".
  # Synthesize a passwd/group with our entry (fixed path keyed by uid, so
  # repeat runs don't pile up temp files). Same shape as bin/claude-in-docker.
  _uid="$(id -u)" _gid="$(id -g)"
  _pw="${TMPDIR:-/tmp}/docker-shim.passwd.$_uid"
  _gr="${TMPDIR:-/tmp}/docker-shim.group.$_uid"
  {
    echo "root:x:0:0:root:/root:/bin/sh"
    echo "${USER:-user}:x:$_uid:$_gid:${USER:-user}:$HOME:/bin/sh"
    echo "nobody:x:65534:65534:nobody:/nonexistent:/usr/sbin/nologin"
  } > "$_pw"
  {
    echo "root:x:0:"
    echo "${USER:-user}:x:$_gid:"
    echo "nobody:x:65534:"
  } > "$_gr"
  run+=(-v "$_pw:/etc/passwd:ro" -v "$_gr:/etc/group:ro")
  # 1Password first, same reasoning as bin/claude-in-docker: the inherited
  # SSH_AUTH_SOCK on macOS is the empty keychain agent.
  one_p_sock="$HOME/Library/Group Containers/2BUA8C4S2C.com.1password/t/agent.sock"
  git_sock=""
  if [[ -S $one_p_sock ]]; then git_sock=$one_p_sock
  elif [[ -n ${SSH_AUTH_SOCK:-} && -S ${SSH_AUTH_SOCK} ]]; then git_sock=$SSH_AUTH_SOCK; fi
  if [[ -n $git_sock ]]; then
    (( _host_home )) || run+=(-v "$git_sock:$git_sock")
    run+=(-e "SSH_AUTH_SOCK=$git_sock")
    run+=(-e "GIT_SSH_COMMAND=ssh -o StrictHostKeyChecking=accept-new")
    # Docker Desktop presents the forwarded socket as root:root 0660; join
    # the root group so the host user (uid 501, not owner) can connect to it.
    run+=(--group-add 0)
    git_params+=('gpg.ssh.program=ssh-keygen')   # op-ssh-sign is a macOS binary
  fi
  if (( ! _host_home )); then
    [[ -f $HOME/.gitconfig ]] && run+=(-v "$HOME/.gitconfig:$HOME/.gitconfig:ro")
    [[ -d $HOME/.private   ]] && run+=(-v "$HOME/.private:$HOME/.private:ro")
    [[ -f $HOME/.config/git/allowed_signers ]] && \
      run+=(-v "$HOME/.config/git/allowed_signers:$HOME/.config/git/allowed_signers:ro")
    # Stage ~/.ssh: config + known_hosts + the public keys the config pins
    # via IdentityFile. The config's `IdentitiesOnly yes / IdentityFile
    # …account.pub` is what stops a read-only deploy key (earlier in the
    # agent) from winning the offer and answering `Hi owner/repo!` instead
    # of `Hi you!`. Private keys stay out — keys come from the agent.
    if [[ -d $HOME/.ssh ]]; then
      _ssh_stage="${TMPDIR:-/tmp}/docker-shim.ssh.$_uid"
      rm -rf "$_ssh_stage"; mkdir -m 700 "$_ssh_stage"
      for _f in config known_hosts; do
        [[ -f $HOME/.ssh/$_f ]] && cp -p "$HOME/.ssh/$_f" "$_ssh_stage/$_f"
      done
      [[ -d $HOME/.ssh/known_hosts.d ]] && cp -pR "$HOME/.ssh/known_hosts.d" "$_ssh_stage/"
      if [[ -f $_ssh_stage/config ]]; then
        awk 'tolower($1)=="identityfile"{print $2}' "$_ssh_stage/config" | while read -r _id; do
          _id="${_id/#\~/$HOME}"
          [[ -f $_id && $_id == *.pub ]] && cp -p "$_id" "$_ssh_stage/"
        done
        chmod 600 "$_ssh_stage/config"
      fi
      [[ -f $_ssh_stage/known_hosts ]] && chmod 644 "$_ssh_stage/known_hosts"
      run+=(-v "$_ssh_stage:$HOME/.ssh:ro")
    fi
  fi
fi
# git's quoted-list format: 'k=v' 'k2=v2'
_gcp=""; for p in "${git_params[@]}"; do _gcp+="'$p' "; done
run+=(-e "GIT_CONFIG_PARAMETERS=${_gcp% }")

run+=(-w "$PWD" -e DOCKER_SHIM_INNER=1)
for e in ${env[@]+"${env[@]}"}; do run+=(-e "$e"); done
# `-e NAME` with no value makes docker copy it from our environment, so a
# secret from `op run` / `sops exec-env` never appears in argv or `ps`.
for n in ${DOCKER_SHIM_ENV:-}; do
  [[ $n =~ ^[A-Za-z_][A-Za-z0-9_]*$ && -n ${!n+x} ]] && run+=(-e "$n")
done
run+=(--entrypoint "${cmd[0]}")

# Lineage label — see _reap_shim_orphans above. Prefer container
# lineage when we're already inside a claude-review container (host
# PPID is meaningless across the docker/host boundary).
if [[ -n "${CLAUDE_REVIEW_CONTAINER_NAME:-}" ]]; then
    run+=(--label "com.claude-shim.parent-container=$CLAUDE_REVIEW_CONTAINER_NAME")
else
    run+=(--label "com.claude-shim.parent-pid=$PPID")
fi

(( ${#extra[@]} )) && run+=("${extra[@]}")
run+=("$image")
(( ${#cmd[@]} > 1 )) && run+=("${cmd[@]:1}")

exec "$docker_bin" "${run[@]}" "$@"
