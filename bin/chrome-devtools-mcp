#!/usr/bin/env bash
# chrome-devtools-mcp, containerised — the browser MCP for Claude Code.
#
# node/npx are docker shims on this machine (bin/docker-shim), so the stock
# `npx chrome-devtools-mcp@latest` runs inside a node:22 container that has no
# browser and no route to the Mac's loopback — it can neither launch Chrome nor
# reach a dev server on 127.0.0.1. This wrapper runs the same package in the
# Playwright image instead (node + Chromium + every shared library Chromium
# needs), headless, and splices the Docker host gateway in for "localhost":
# Chrome resolves that name to loopback before consulting DNS or /etc/hosts, so
# --host-resolver-rules is the only hook that works. Vite's host check passes
# because the browser still sends Host: localhost.
#
# Registered by install.sh:
#   claude mcp add --scope user chrome-devtools -- ~/.dotfiles/bin/chrome-devtools-mcp
#
# From an agent, navigate to http://localhost:<port> — NOT 127.0.0.1, an IP
# literal bypasses the resolver rule. $HOME is mounted at the same path, so a
# screenshot filePath under $HOME lands where it says.
#
# Env: CHROME_DEVTOOLS_MCP_IMAGE (default below; the tag pins the Chromium
#      build), CHROME_DEVTOOLS_MCP_VIEWPORT (default 1440x900).
# Any extra arguments are passed through to chrome-devtools-mcp.
set -euo pipefail

IMAGE="${CHROME_DEVTOOLS_MCP_IMAGE:-mcr.microsoft.com/playwright:v1.62.1-noble}"
VIEWPORT="${CHROME_DEVTOOLS_MCP_VIEWPORT:-1440x900}"

run=(run --rm -i -u "$(id -u):$(id -g)" -v "$HOME:$HOME" -e HOME="$HOME")
case "$PWD" in
  "$HOME"|"$HOME"/*) : ;;
  *) run+=(-v "$PWD:$PWD") ;;
esac
# Same lineage label the shims use, so claude-clean / docker-shim reap it if
# the parent dies without closing stdin.
run+=(-w "$PWD" --label "com.claude-shim.parent-pid=$PPID" --entrypoint sh "$IMAGE")

# The image's /bin/sh is dash: keep the inner script POSIX.
exec docker "${run[@]}" -c '
  viewport=$1; shift
  gw=$(getent hosts host.docker.internal | awk "{print \$1}")
  chrome=$(ls -d /ms-playwright/chromium-*/chrome-linux/chrome | head -n1)
  # --allow-unrestricted-paths: without it screenshots/snapshots may only be
  # written to the container'"'"'s /tmp, which nothing on the host can see. The
  # container mounts only $HOME (and $PWD), so "unrestricted" is bounded there.
  exec npx -y chrome-devtools-mcp@latest \
    --headless --isolated --no-usage-statistics --allow-unrestricted-paths \
    --executablePath "$chrome" \
    --viewport "$viewport" \
    --chrome-arg=--no-sandbox \
    --chrome-arg=--disable-setuid-sandbox \
    --chrome-arg=--disable-dev-shm-usage \
    --chrome-arg="--host-resolver-rules=MAP localhost $gw" \
    "$@"
' -- "$VIEWPORT" "$@"
