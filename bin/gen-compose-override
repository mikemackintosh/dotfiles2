#!/usr/bin/env bash
# gen-compose-override — namespace a docker-compose stack for a PR review
# so parallel reviews don't collide on ports, container names, or volumes.
#
# Usage:
#   gen-compose-override <workdir> <pr-number>
#
# What it writes into <workdir>:
#   .env.review                 COMPOSE_PROJECT_NAME + one PORT var per
#                               (service, container-port) that had a host
#                               binding in the base compose file.
#   docker-compose.override.yml Uses the `!override` tag to replace each
#                               service's ports: list with a randomized
#                               host-side binding.
#
# Exits 0 (silently) if there is no compose file or docker/jq aren't
# available — safe to call unconditionally from git-review.
#
# Requires Docker Compose v2.24+ for the `!override` tag.

set -euo pipefail

workdir="${1:?usage: gen-compose-override <workdir> <pr>}"
pr="${2:?usage: gen-compose-override <workdir> <pr>}"

cd "$workdir"

compose_file=""
for f in docker-compose.yml docker-compose.yaml compose.yml compose.yaml; do
    if [[ -f $f ]]; then compose_file=$f; break; fi
done
if [[ -z $compose_file ]]; then
    echo "gen-compose-override: no compose file in $workdir — skipping"
    exit 0
fi

for bin in docker jq nc; do
    if ! command -v "$bin" >/dev/null 2>&1; then
        echo "gen-compose-override: $bin not on PATH — skipping" >&2
        exit 0
    fi
done

if ! config_json=$(docker compose config --format json 2>/dev/null); then
    echo "gen-compose-override: 'docker compose config' failed — skipping" >&2
    exit 0
fi

project="review-pr-$pr"
env_file=".env.review"
override_file="docker-compose.override.yml"

pick_free_port() {
    local p
    while :; do
        p=$(( (RANDOM % 16000) + 49152 ))
        if ! nc -z 127.0.0.1 "$p" >/dev/null 2>&1; then
            printf '%s\n' "$p"
            return
        fi
    done
}

# One line per (service, container-port). Short-form "HOST:CONTAINER" and
# long-form {target: N} both flow into the same shape.
pairs=$(printf '%s' "$config_json" | jq -r '
    (.services // {}) | to_entries[]
    | .key as $svc
    | (.value.ports // [])[]
    | if type == "object" then (.target // .containerPort // empty)
      else (tostring | capture("^(?:[^:]*:)?(?<c>[0-9]+)(?:/.*)?$") | .c // empty)
      end
    | select(. != null and . != "")
    | [$svc, .] | @tsv
' 2>/dev/null || true)

{
    printf '# generated by gen-compose-override for PR #%s\n' "$pr"
    printf 'COMPOSE_PROJECT_NAME=%s\n' "$project"
} > "$env_file"

{
    printf '# generated by gen-compose-override for PR #%s\n' "$pr"
    printf '# Requires Docker Compose v2.24+ (uses the !override tag).\n'
    printf 'services:\n'
} > "$override_file"

if [[ -z ${pairs//[[:space:]]/} ]]; then
    echo "gen-compose-override: no host-bound ports found; only namespacing project"
    printf 'wrote %s and %s (project=%s)\n' "$env_file" "$override_file" "$project"
    exit 0
fi

prev_svc=""
while IFS=$'\t' read -r svc cport; do
    [[ -z $svc || -z $cport ]] && continue
    var=$(printf '%s_%s_PORT' "$svc" "$cport" | tr '[:lower:]-' '[:upper:]_')
    port=$(pick_free_port)
    printf '%s=%s\n' "$var" "$port" >> "$env_file"
    if [[ $svc != "$prev_svc" ]]; then
        printf '  %s:\n    ports: !override\n' "$svc" >> "$override_file"
        prev_svc=$svc
    fi
    printf '      - "${%s}:%s"\n' "$var" "$cport" >> "$override_file"
done <<< "$pairs"

printf 'wrote %s and %s (project=%s)\n' "$env_file" "$override_file" "$project"
