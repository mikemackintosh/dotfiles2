<?xml version="1.0" encoding="UTF-8"?>
<!-- Template for ~/Library/LaunchAgents/dotfiles.image-audit.plist.
     install.sh fills in the BIN / LOG / PATH placeholders for this machine
     and loads it. Runs `image-audit --fix` weekly (Mon 09:00). -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>dotfiles.image-audit</string>
  <key>ProgramArguments</key>
  <array>
    <string>__BIN__</string>
    <string>--fix</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>1</integer>
    <key>Hour</key><integer>9</integer>
    <key>Minute</key><integer>0</integer>
  </dict>
  <key>RunAtLoad</key><false/>
  <key>StandardOutPath</key><string>__LOG__</string>
  <key>StandardErrorPath</key><string>__LOG__</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>__PATH__</string>
  </dict>
</dict>
</plist>
