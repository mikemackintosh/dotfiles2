# Public dotfiles git config. Personal identity (user.name, user.email,
# signing key) and signing setup live in ~/.private/gitconfig — see
# gitconfig.private.example in this repo for the expected shape.

[init]
  defaultBranch = main

[branch]
  autosetuprebase = always

[pull]
  rebase = true

[format]
  signoff = true

[grep]
  linenumber = true

[push]
  default = simple

[color]
  ui = true

[color "branch"]
  current = yellow reverse
  local = yellow
  remote = green

[color "diff"]
  commit = green
  meta = yellow
  frag = cyan
  old = red
  new = green
  whitespace = red reverse

[color "status"]
  added = yellow
  changed = green
  untracked = cyan

[merge]
  ff = false
  tool = vimdiff
  log = true

[help]
  autocorrect = 1

[alias]
  d = diff --patience
  br = branch
  ci = commit -a
  cm = commit -m
  co = checkout
  st = status

  up = pull
  upstream = remote add upstream
  main = !git checkout main && git pull
  lg = log --graph --abbrev-commit --decorate --format=format:'%C(bold blue)%h%C(reset) - %C(bold green)(%ar)%C(reset) %C(white)%s%C(reset) %C(dim white)- %an%C(reset)%C(bold yellow)%d%C(reset)'
  lgo = log --graph --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative
  lga = log --graph --all --pretty=format:'%Cred%h%Creset -%C(yellow)%d%Creset %s %Cgreen(%cr) %C(bold blue)<%an>%Creset' --abbrev-commit --date=relative

[core]
  excludesfile = ~/.gitignore
  whitespace   = space-before-tab,-indent-with-non-tab,trailing-space
  trustctime   = false
  pager = delta
  # Global hooks (currently: gitleaks pre-push). Overrides per-repo
  # .git/hooks — repos that need their own can opt out with:
  #   git config --local core.hooksPath .git/hooks

[interactive]
  diffFilter = delta --color-only --features=interactive

[delta]
  features = decorations

[delta "interactive"]
  keep-plus-minus-markers = false

[delta "decorations"]
  commit-decoration-style = blue ol
  commit-style = raw
  file-style = omit
  hunk-header-decoration-style = blue box
  hunk-header-file-style = red
  hunk-header-line-number-style = "#067a00"
  hunk-header-style = file line-number syntax

[url "ssh://git@github.com/"]
  insteadOf = gh:
  insteadOf = ghub:
  insteadOf = github:
  insteadOf = http://github.com/
  # Committing the https rewrite is safe here because keys come from the
  # 1Password agent, which ssh/config wires up for Host * — so a machine
  # with this config almost always has a key. The one bootstrap that runs
  # before any key exists, the Homebrew installer, is pinned to
  # GIT_CONFIG_GLOBAL=/dev/null in install.sh for exactly this reason.
  # Residual trade: on a keyless machine, tools that clone a public GitHub
  # https URL (go get, npm github: deps, pip VCS) fail until a key is added.
  insteadOf = https://github.com/

# Longest-prefix passthrough. Git applies the longest matching insteadOf,
# and this one maps to itself, so Homebrew is exempt from the https->ssh
# rewrite above and `brew update` keeps fetching taps over https.
# Capital H matters: insteadOf matching is case-sensitive, so the lowercase
# section below does not cover a real Homebrew remote.
[url "https://github.com/Homebrew/"]
  insteadOf = https://github.com/Homebrew/

[url "https://github.com/homebrew/"]
  insteadOf = homebrew:
  insteadOf = brew:
  insteadOf = ssh://git@github.com:homebrew

[url "ssh://git@rocketbox.ai/"]
  insteadOf = https://rocketbox.ai/

# Per-OS overrides — no-op if the target file is absent.
[IncludeIf "gitdir:/Users"]
  path = ~/.gitconfig-osx

[IncludeIf "gitdir:/home"]
  path = ~/.gitconfig-linux

[IncludeIf "gitdir:C:"]
  path = ~/.gitconfig-windows

# Machine-local identity + signing. Last include wins, so this
# overrides anything above. See gitconfig.private.example.
[include]
  path = ~/.private/gitconfig

# Per-directory identity overlays. Each block applies only when the
# repo's gitdir lives under the given path (trailing slash matters —
# it makes the match recursive). Keeps work commits attributed to
# the work email automatically, without a pre-commit guard.
[includeIf "gitdir:~/go/src/github.com/wealthsimple/"]
  path = ~/.private/gitconfig-work

# The signing key itself lives in ~/.private/gitconfig; only the
# verification list is safe to commit. Must sit after [include] to win.
[gpg "ssh"]
  allowedSignersFile = ~/.config/git/allowed_signers
