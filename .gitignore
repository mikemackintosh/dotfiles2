# macOS junk
.DS_Store
._*

# Editor swap files
*.swp
*.swo
*~

# Runtime state for prompt + vim theme pickers (not config)
.zp-theme
.vim-theme

# Local-only sourced files
*.local.zsh

# Per-machine project list for bin/tmux-sessionizer
.tmux-sessionizer-paths

# Override the global ~/.gitignore that excludes CLAUDE.md by default —
# this repo deliberately tracks its CLAUDE.md as house-rules documentation.
!CLAUDE.md

# vim runtime dirs (created on-demand by ~/.vim/vimrc)
vim/undo/
vim/backup/
vim/swap/
vim/.netrwhist
